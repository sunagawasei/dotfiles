      "Bash(helm list:*)",
      "Bash(helm get:*)",
      "Bash(helm show:*)",
      "Bash(helm status:*)",
      "Bash(cd:*)",
      "Bash(jq:*)",
      "Bash(herdr pane list:*)",
      "Bash(herdr pane get:*)",
      "Bash(herdr pane read:*)",
      "Bash(herdr pane current:*)",
      "Bash(herdr pane process-info:*)",
      "Bash(herdr workspace list:*)",
      "Bash(herdr workspace get:*)",
      "Bash(darwin-apply)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(mongod:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm remove:*)",
      "Bash(kubectl cordon:*)",
      "Bash(kubectl uncordon:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl patch:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Read(.env*)",
      "Read(.env.*)",
      "Read(secrets)",
      "Read(.secrets/**)",
      "Read(**/*credentials)",
      "Read(**/credentials/**)",
      "Read(**/*credentials*.json)",
      "Read(**/*credentials*.yaml)",
      "Read(**/*credentials*.yml)",
      "Read(**/*credentials*.ini)",
      "Read(**/*credentials*.pem)",
      "Read(**/*credentials*.txt)",
      "Read(**/*.token)",
      "Read(**/*token)",
      "Read(**/*access_token*)",
      "Read(**/*refresh_token*)",
      "Read(**/*auth_token*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Edit(.env*)",
      "Edit(**/secrets/**)",
      "Bash(sudo:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(pipx:*)",
      "Bash(poetry:*)",
      "Bash(python -m pip:*)",
      "Bash(python3 -m pip:*)",
      "mcp__supabase__execute_sql",
      "Bash(helm*--post-renderer*)",
      "Bash(kustomize*--enable-alpha-plugins*)",
      "Bash(kustomize*--enable-exec*)",
      "Bash(kustomize*--helm-command*)",
      "EnterPlanMode"
    ]
  },
  "plansDirectory": ".claude/plans",
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "enableWeakerNetworkIsolation": true,
    "enabled": false,
    "excludedCommands": [
      "git:*",
      "gh:*",
      "docker:*",
      "go:*",
      "terraform:*",
      "codex:*",
      "copilot:*",
      "cursor-agent:*",
      "worklog:*",
      "aws:*",
      "kubectl:*",
      "hunk:*",
      "dig:*",
      "container:*",
      "agent:*",
      "ps:*",
      "pgrep:*",
      "~/.agents/skills/agmsg/scripts/ensure-codex.sh:*",
      "~/.agents/skills/agmsg/scripts/spawn.sh:*",
      "~/.agents/skills/agmsg/scripts/delivery.sh:*",
      "~/.agents/skills/agmsg/scripts/send.sh:*"
    ],
    "filesystem": {
      "allowRead": [],
      "allowWrite": [
        "/tmp",
        "~/.claude",
        "~/.config/claude/plugins/data",
        "~/.config/codex",
        "~/.config/cursor",
        "~/.cursor/projects",
        "~/.agents/skills/agmsg/",
        "~/Library/Caches/go-build",
        "~/go",
        "~/Library/Caches/golangci-lint"
      ]
    },
    "network": {
      "allowUnixSockets": [
        "~/.config/herdr/herdr.sock",
        "~/.agents/skills/agmsg/run"
      ],
      "allowedDomains": [
        "proxy.golang.org",
        "sum.golang.org",
        "github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com"
      ]
    }
  },
  "skillOverrides": {
    "session-verify": "off",
    "split-commits": "off"
  },
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "command": "~/.config/claude/statusline.sh",
    "refreshInterval": 5,
    "type": "command"
  },
  "syntaxHighlightingDisabled": false,
  "theme": "custom:ghost-visor",
  "tui": "fullscreen",
  "useAutoModeDuringPlan": true,
  "verbose": false
}
