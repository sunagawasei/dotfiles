{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "fable",
  "attribution": {
    "pr": ""
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(darwin-rebuild build:*) in ~/.config — non-applying evaluation/build check, explicitly called out in CLAUDE.md as safe pre-check",
      "Bash(cd scripts && go run ./cmd/generate-colors:*) in ~/.config — routine color-system generation step",
      "Bash(cd scripts && go run ./cmd/verify-colors:*) in ~/.config — routine color-system validation step"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(darwin-rebuild switch:*) in ~/.config — applies system-wide changes via sudo wrapper; review before auto-approving",
      "Bash(brew bundle --cleanup:*) in ~/.config — known to abort darwin-rebuild switch and documented as disabled/dangerous in CLAUDE.md"
    ]
  },
  "editorMode": "vim",
  "enabledPlugins": {
    "aws-serverless@agent-plugins-for-aws": false,
    "aws-serverless@claude-plugins-official": false,
    "cc-plugin-you-should-know@builtin": true,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "databases-on-aws@agent-plugins-for-aws": false,
    "deploy-on-aws@agent-plugins-for-aws": false,
    "deploy-on-aws@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "modern-go-guidelines@goland-claude-marketplace": true,
    "notion@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "serena@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false
  },
  "env": {
    "AGMSG_CURSOR_BRIDGE_TURN_TIMEOUT": "1800",
    "CLAUDE_AFK_TIMEOUT_MS": "86400000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "extraKnownMarketplaces": {
    "agent-plugins-for-aws": {
      "source": {
        "repo": "awslabs/agent-plugins",
        "source": "github"
      }
    },
    "goland-claude-marketplace": {
      "source": {
        "repo": "JetBrains/go-modern-guidelines",
        "source": "github"
      }
    }
  },
  "feedbackDrafts": "off",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.config/claude/hooks/herdr-notify",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "idle_prompt"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.config/claude/hooks/add_newline",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/assign-pr-author.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.config/claude/hooks/bounded-background",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '~/.config/claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "~/.config/claude/hooks/herdr-task-label",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "~/.config/claude/hooks/subagent-busy",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.config/claude/hooks/herdr-task-label",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "~/.config/claude/hooks/herdr-notify",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "~/.config/claude/hooks/subagent-busy",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "~/.config/claude/hooks/subagent-busy",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.config/claude/hooks/herdr-task-label",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "~/.config/claude/hooks/herdr-title",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "language": "日本語",
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "outputStyle": "Concise",
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(nvim:*)",
      "Bash(find:*)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",
      "Bash(sed:*)",
      "Bash(lazygit:*)",
      "WebFetch(domain:wezterm.org)",
      "Bash(defaults read:*)",
      "WebFetch(domain:wezfurlong.org)",
      "mcp__ide__getDiagnostics",
      "Bash(cat:*)",
      "WebFetch(domain:ghostty.org)",
      "Read(~/.local/share/nvim/lazy/**)",
      "Read(~/.local/bin/**)",
      "Read(~/.cache/nvim/**)",
      "Bash(tree:*)",
      "Bash(gh repo view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
