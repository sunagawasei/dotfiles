      "Bash(npx cdk diff:*)",
      "Bash(go test:*)",
      "Bash(codex:*)",
      "Bash(copilot:*)",
      "Bash(cursor-agent:*)",
      "Bash(agent:*)",
      "Bash(aws ecs list-clusters:*)",
      "Bash(aws ecs list-services:*)",
      "Bash(aws ecs describe-services:*)",
      "Bash(aws ecs describe-task-definition:*)",
      "Bash(aws ecs list-tasks:*)",
      "Bash(aws ecs describe-tasks:*)",
      "Bash(aws elbv2 describe-load-balancers:*)",
      "Bash(aws elbv2 describe-listeners:*)",
      "Bash(aws elbv2 describe-target-groups:*)",
      "Bash(aws elbv2 describe-target-health:*)",
      "Bash(aws rds describe-db-clusters:*)",
      "Bash(aws rds describe-db-instances:*)",
      "Bash(aws rds describe-db-engine-versions:*)",
      "Bash(aws rds describe-db-cluster-parameter-groups:*)",
      "Bash(aws rds describe-db-cluster-parameters:*)",
      "Bash(aws rds describe-db-subnet-groups:*)",
      "Bash(aws rds describe-events:*)",
      "Bash(aws rds wait:*)",
