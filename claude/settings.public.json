      "Bash(git:*)",
      "Bash(brew info:*)",
      "Bash(brew tap-info:*)",
      "Bash(brew tap:*)",
      "Bash(nix search:*)",
      "Bash(brew search:*)",
      "Bash(nix flake:*)",
      "Bash(gh release:*)",
      "Bash(~/.agents/skills/agmsg/scripts/send.sh:*)",
      "Bash(~/.agents/skills/agmsg/scripts/watch.sh:*)",
