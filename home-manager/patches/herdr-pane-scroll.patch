+fn pane_scroll(args: &[String]) -> std::io::Result<i32> {
+    let usage = "usage: herdr pane scroll <pane_id> --direction up|down --lines N";
+    if args.is_empty() {
+        eprintln!("{usage}");
+        return Ok(2);
+    }
+
+    let pane_id = super::normalize_pane_id(&args[0]);
+    let mut direction = None;
+    let mut lines = None;
+    let mut index = 1;
+    while index < args.len() {
+        match args[index].as_str() {
+            "--direction" => {
+                let Some(value) = args.get(index + 1) else {
+                    eprintln!("missing value for --direction");
+                    return Ok(2);
+                };
+                direction = Some(match value.as_str() {
+                    "up" => PaneScrollDirection::Up,
+                    "down" => PaneScrollDirection::Down,
+                    other => {
+                        eprintln!("invalid direction: {other}");
+                        return Ok(2);
+                    }
+                });
+                index += 2;
+            }
+            "--lines" => {
+                let Some(value) = args.get(index + 1) else {
+                    eprintln!("missing value for --lines");
+                    return Ok(2);
+                };
+                let Ok(parsed) = value.parse::<u64>() else {
+                    eprintln!("invalid lines: {value}");
+                    return Ok(2);
+                };
+                if parsed == 0 {
+                    eprintln!("lines must be non-zero");
+                    return Ok(2);
+                }
+                lines = Some(parsed);
+                index += 2;
+            }
+            other => {
+                eprintln!("unknown option: {other}");
+                return Ok(2);
+            }
+        }
+    }
+
+    let (Some(direction), Some(lines)) = (direction, lines) else {
+        eprintln!("{usage}");
+        return Ok(2);
+    };
+    super::send_ok_request(Method::PaneScroll(PaneScrollParams {
+        pane_id,
+        direction,
+        lines,
+    }))
+}
