+    pub(super) fn handle_pane_scroll(&mut self, id: String, params: PaneScrollParams) -> String {
+        if params.lines == 0 {
+            return encode_error(id, "invalid_scroll", "lines must be non-zero");
+        }
+        let Some((ws_idx, pane_id)) = self.parse_pane_id(&params.pane_id) else {
+            return pane_not_found(id, &params.pane_id);
+        };
+        let Some(runtime) = self.lookup_runtime_sender(ws_idx, pane_id) else {
+            return pane_not_found(id, &params.pane_id);
+        };
+        // The alternate screen is the app's own view. Host scroll would move
+        // the hidden primary buffer, so the caller can inject a key instead.
+        if runtime.alternate_screen_active() {
+            return encode_error(id, "alternate_screen", "pane is on the alternate screen");
+        }
+        let lines = usize::try_from(params.lines).unwrap_or(usize::MAX);
+        match params.direction {
+            PaneScrollDirection::Up => runtime.scroll_up(lines),
+            PaneScrollDirection::Down => runtime.scroll_down(lines),
+        }
+        self.render_dirty.request_generic();
+        self.render_notify.notify_one();
+        encode_success(id, ResponseResult::Ok {})
+    }
 }
 
