+/// Cap on the sanitized display name length, so a process advertising an
+/// unusually long name can't stretch the confirmation dialog.
+const DISPLAY_NAME_MAX_LEN: usize = 32;
+
+/// Display name for a foreground group leader. `normalized_process_name` may
+/// fall back to raw argv0 (process-controlled, can carry secrets or control
+/// characters) when it can't resolve a known agent, so this only trusts that
+/// result when it round-trips through the agent allowlist; otherwise it falls
+/// back to the kernel-reported `comm` name. Either way the result is
+/// sanitized before display.
+fn foreground_display_name(leader: &crate::platform::ForegroundProcess) -> String {
+    let resolved = normalized_process_name(leader);
+    let name = if identify_agent(&resolved).is_some() {
+        resolved
+    } else {
+        leader.name.clone()
+    };
+    sanitize_display_name(path_basename(&name))
+}
+
+fn sanitize_display_name(name: &str) -> String {
+    name.chars()
+        .filter(|c| !c.is_control())
+        .take(DISPLAY_NAME_MAX_LEN)
+        .collect()
 }
 
