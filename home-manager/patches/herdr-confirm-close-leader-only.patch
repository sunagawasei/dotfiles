+pub fn pane_foreground_display_name(shell_pid: u32) -> Option<String> {
+    let fg_pgid = foreground_process_group_id(shell_pid)?;
+    let job = foreground_group_leader_job(fg_pgid)?;
+    let leader = job.processes.into_iter().next()?;
+    Some(foreground_display_name(&leader))
 }
 
