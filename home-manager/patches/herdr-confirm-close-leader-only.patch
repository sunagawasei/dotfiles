+/// Returns true when the pane shell's tty foreground job is something other
+/// than the pane's own shell idling at its prompt.
+///
+/// Close confirmation uses this predicate. A pgid other than the pane shell's
+/// own always counts as running (a shell script, nested shell, or program the
+/// shell launched). When the foreground pgid IS the pane shell's own, it's
+/// idle only if the leader is shell-like with no non-flag argv — otherwise it
+/// counts as running (this also covers direct/argv command panes and
+/// agent-launched panes, where `shell_pid` names the agent itself, not a
+/// shell). A leader we couldn't look up fails closed as running.
+///
+/// Known limitation: without job control (`set +m`, non-interactive shells) a
+/// foreground child can share the shell's own pgid, in which case it's
+/// indistinguishable from the idle shell and won't trigger confirmation.
+pub fn pane_has_running_foreground(shell_pid: u32) -> bool {
+    let fg_pgid = foreground_process_group_id(shell_pid);
+    let leader = fg_pgid
+        .and_then(foreground_group_leader_job)
+        .and_then(|job| job.processes.into_iter().next());
+    foreground_job_is_running(fg_pgid, shell_pid, leader.as_ref())
 }
 
