+    #[test]
+    fn expanded_sidebar_workspace_numbers_match_digit_shortcuts() {
+        use crate::input::TerminalKey;
+        use crossterm::event::{KeyCode, KeyModifiers};
+
+        let config: crate::config::Config =
+            toml::from_str("[keys]\nswitch_workspace = \"prefix+1..9\"\n").unwrap();
+        let mut app = crate::app::App::new(
+            &config,
+            true,
+            None,
+            tokio::sync::mpsc::unbounded_channel().1,
+            crate::api::EventHub::default(),
+        );
+        app.state.workspaces = vec![
+            workspace_with_worktree_space("main", Some("repo-key"), "/repo/herdr"),
+            Workspace::test_new("notes"),
+            workspace_with_worktree_space("issue", Some("repo-key"), "/repo/herdr-issue"),
+            Workspace::test_new("scratch"),
+            workspace_with_worktree_space("review", Some("repo-key"), "/repo/herdr-review"),
+        ];
+        app.state.ensure_test_terminals();
+
+        for (collapsed, active, scroll, expected) in [
+            (false, 0, 0, &[0, 2, 4, 1, 3][..]),
+            (true, 0, 0, &[0, 1, 3][..]),
+            (true, 4, 0, &[0, 4, 1, 3][..]),
+            (false, 0, 1, &[2, 4, 1, 3][..]),
+        ] {
+            if collapsed {
+                app.state.collapsed_space_keys.insert("repo-key".into());
+            } else {
+                app.state.collapsed_space_keys.remove("repo-key");
+            }
+
+            let area = Rect::new(0, 0, 30, 30);
+            for mode in [Mode::Prefix, Mode::Navigate] {
+                app.state.mode = mode;
+                app.state.active = Some(active);
+                app.state.selected = active;
+                app.state.workspace_scroll = scroll;
+                let cards = compute_workspace_card_areas(&app.state, area);
+                assert_eq!(
+                    cards.iter().map(|card| card.ws_idx).collect::<Vec<_>>(),
+                    expected
+                );
+                app.state.view.workspace_card_areas = cards.clone();
+                let list_area = workspace_list_rect(area, app.state.sidebar_section_split);
+                let mut terminal =
+                    Terminal::new(TestBackend::new(area.width, area.height)).unwrap();
+                terminal
+                    .draw(|frame| {
+                        render_workspace_list(
+                            &app.state,
+                            &app.terminal_runtimes,
+                            frame,
+                            list_area,
+                            mode == Mode::Navigate,
+                        )
+                    })
+                    .unwrap();
+
+                for (position, card) in cards.iter().enumerate() {
+                    let digit = terminal.backend().buffer()[(card.rect.x, card.rect.y)]
+                        .symbol()
+                        .chars()
+                        .next()
+                        .unwrap();
+                    app.state.mode = mode;
+                    app.state.active = Some(active);
+                    app.state.selected = active;
+                    let key = TerminalKey::new(KeyCode::Char(digit), KeyModifiers::empty());
+                    if mode == Mode::Prefix {
+                        app.handle_prefix_key(key);
+                    } else {
+                        app.handle_navigate_key(key);
+                    }
+                    assert_eq!(
+                        app.state.active,
+                        Some(card.ws_idx),
+                        "digit {digit}, {mode:?}"
+                    );
+                    assert_eq!(app.state.mode, Mode::Terminal);
+                    assert_eq!(digit.to_digit(10), Some((scroll + position + 1) as u32));
+                }
+            }
+        }
+    }
