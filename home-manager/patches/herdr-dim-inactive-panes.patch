+
+    struct DimRenderCase {
+        app: AppState,
+        runtimes: TerminalRuntimeRegistry,
+        pane_infos: Vec<PaneInfo>,
+    }
+
+    fn dim_runtime() -> TerminalRuntime {
+        TerminalRuntime::test_with_scrollback_bytes(40, 8, 1024, b"ready\n")
+    }
+
+    fn dim_case(workspace: Workspace) -> DimRenderCase {
+        let mut app = AppState::test_new();
+        app.mode = Mode::Terminal;
+        app.workspaces = vec![workspace];
+        app.active = Some(0);
+
+        let area = Rect::new(0, 0, 40, 8);
+        let runtimes = TerminalRuntimeRegistry::new();
+        let pane_infos = compute_pane_infos(
+            &app,
+            &runtimes,
+            area,
+            false,
+            crate::kitty_graphics::HostCellSize::default(),
+        );
+
+        DimRenderCase {
+            app,
+            runtimes,
+            pane_infos,
+        }
+    }
+
+    fn dim_split_case() -> DimRenderCase {
+        let mut workspace = Workspace::test_new("test");
+        let root = workspace.tabs[0].root_pane;
+        let split = workspace.test_split(ratatui::layout::Direction::Horizontal);
+        workspace.tabs[0].runtimes.insert(root, dim_runtime());
+        workspace.tabs[0].runtimes.insert(split, dim_runtime());
+        dim_case(workspace)
+    }
+
+    fn dim_single_pane_case() -> DimRenderCase {
+        let mut workspace = Workspace::test_new("test");
+        let root = workspace.tabs[0].root_pane;
+        workspace.tabs[0].runtimes.insert(root, dim_runtime());
+        dim_case(workspace)
+    }
+
+    fn dim_zoomed_case() -> DimRenderCase {
+        let mut workspace = Workspace::test_new("test");
+        let root = workspace.tabs[0].root_pane;
+        let split = workspace.test_split(ratatui::layout::Direction::Horizontal);
+        workspace.tabs[0].runtimes.insert(root, dim_runtime());
+        workspace.tabs[0].runtimes.insert(split, dim_runtime());
+        workspace.zoomed = true;
+        dim_case(workspace)
+    }
+
+    /// One `(is_focused, content_is_dimmed)` pair per rendered pane.
+    fn dim_flags(case: &DimRenderCase) -> Vec<(bool, bool)> {
+        let mut terminal =
+            ratatui::Terminal::new(ratatui::backend::TestBackend::new(40, 8)).unwrap();
+        terminal
+            .draw(|frame| render_panes(&case.app, &case.runtimes, frame, &case.pane_infos, &[]))
+            .unwrap();
+        let buffer = terminal.backend().buffer().clone();
+
+        case.pane_infos
+            .iter()
+            .map(|info| {
+                let inner = info.inner_rect;
+                assert!(inner.width > 0 && inner.height > 0);
+                let probe = (inner.x + inner.width / 2, inner.y + inner.height / 2);
+                let dimmed = buffer[probe].style().add_modifier.contains(Modifier::DIM);
+                (info.is_focused, dimmed)
+            })
+            .collect()
+    }
