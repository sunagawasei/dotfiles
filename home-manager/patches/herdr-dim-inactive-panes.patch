+    /// Restores the previous `CONFIG_PATH_ENV_VAR` (or clears it, if it was unset) and
+    /// removes the temp config file on drop, so a mid-test panic can't leave the env var
+    /// pointed at a deleted file or leak the temp file for later tests to trip over.
+    struct ConfigPathEnvGuard {
+        previous: Option<std::ffi::OsString>,
+        path: std::path::PathBuf,
+    }
+
+    impl ConfigPathEnvGuard {
+        fn set(path: std::path::PathBuf) -> Self {
+            let previous = std::env::var_os(crate::config::CONFIG_PATH_ENV_VAR);
+            std::env::set_var(crate::config::CONFIG_PATH_ENV_VAR, &path);
+            Self { previous, path }
+        }
+    }
+
+    impl Drop for ConfigPathEnvGuard {
+        fn drop(&mut self) {
+            match self.previous.take() {
+                Some(value) => std::env::set_var(crate::config::CONFIG_PATH_ENV_VAR, value),
+                None => std::env::remove_var(crate::config::CONFIG_PATH_ENV_VAR),
+            }
+            let _ = std::fs::remove_file(&self.path);
+        }
+    }
+
+    #[test]
+    fn config_path_env_guard_restores_previous_value_and_removes_temp_file() {
+        let _lock = crate::config::test_config_env_lock().lock().unwrap();
+        let sentinel = std::env::temp_dir().join("herdr-config-guard-sentinel.toml");
+        std::env::set_var(crate::config::CONFIG_PATH_ENV_VAR, &sentinel);
+
+        let path = std::env::temp_dir().join(format!(
+            "herdr-headless-dim-reload-guard-{}-{}.toml",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .map(|d| d.as_nanos())
+                .unwrap_or(0)
+        ));
+        std::fs::write(&path, "[ui]\n").unwrap();
+        {
+            let _guard = ConfigPathEnvGuard::set(path.clone());
+            assert_eq!(
+                std::env::var(crate::config::CONFIG_PATH_ENV_VAR).unwrap(),
+                path.to_string_lossy()
+            );
+            assert!(path.exists());
+        }
+        assert_eq!(
+            std::env::var(crate::config::CONFIG_PATH_ENV_VAR).unwrap(),
+            sentinel.to_string_lossy(),
+            "guard must restore the previous value even when one was already set"
+        );
+        assert!(!path.exists(), "guard must remove the temp file on drop");
+
+        std::env::remove_var(crate::config::CONFIG_PATH_ENV_VAR);
+    }
