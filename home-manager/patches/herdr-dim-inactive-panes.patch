+        // This is the core of the fix: dimming used to be suppressed whenever
+        // `app.mode == Mode::Terminal`, which is where a session spends nearly
+        // all of its time, making the feature effectively unreachable.
+        let case = dim_split_case();
+        assert!(case.app.dim_inactive_panes);
+        assert_eq!(case.app.mode, Mode::Terminal);
+
+        let flags = dim_flags(&case);
+
+        assert_eq!(flags.len(), 2);
+        assert!(flags.contains(&(false, true)));
+        assert!(flags.contains(&(true, false)));
