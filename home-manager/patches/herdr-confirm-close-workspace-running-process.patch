+        // pane: off => closes immediately even with a running process attached.
+        let mut pane_app = app_with_solo_workspace();
+        pane_app.state.confirm_close_running_process = false;
+        let pane_id = pane_app.state.workspaces[0].tabs[0].root_pane;
+        attach_running_pid(&mut pane_app, 0, pane_id, 7474);
+
+        let deferred = pane_app.close_focused_pane_via_api_requires_confirmation();
+
+        assert!(!deferred);
+        assert!(pane_app.state.workspaces.is_empty());
+
+        // workspace: off => always asks, without even scanning for a running process.
+        let mut ws_app = app_with_test_workspaces(&["solo"]);
+        ws_app.state.confirm_close_running_process = false;
+
+        let result = ws_app.workspace_close_confirmation_with(0, |_pid| {
+            panic!("running_name must not be called when confirm_close_running_process is false")
+        });
+
+        assert_eq!(result, WorkspaceCloseConfirm::Ask { process_name: None });
+    }
