+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum WorkspaceCloseConfirm {
+    Skip,
+    Ask { process_name: Option<String> },
+}
+
+impl AppState {
+    // 本体。プロセス判定を注入可能にして、`App` を持たないcfg(test) helperからも
+    // 本番と同じ判定(idleならSkip)を通せるようにする。
+    pub(crate) fn workspace_close_confirmation_with(
+        &self,
+        ws_idx: usize,
+        running_in_workspace: impl Fn(&Self, usize) -> Option<String>,
+    ) -> WorkspaceCloseConfirm {
+        if !self.confirm_close {
+            return WorkspaceCloseConfirm::Skip;
+        }
+        if !self.confirm_close_running_process {
+            return WorkspaceCloseConfirm::Ask { process_name: None };
+        }
+        let targets = self.workspaces_closed_with(ws_idx);
+        // group close は他のworkspaceも消すので、アイドルでも確認する。
+        let closes_group = targets.len() >= 2;
+        let process_name = targets
+            .iter()
+            .find_map(|idx| running_in_workspace(self, *idx));
+        if closes_group || process_name.is_some() {
+            WorkspaceCloseConfirm::Ask { process_name }
+        } else {
+            WorkspaceCloseConfirm::Skip
+        }
+    }
+}
